{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.18"
  },
  "type": "row",
  "preview": "layouts/herdr-glass.svg",
  "titlebar": "none",
  "traffic_lights": [
    24,
    26
  ],
  "toast": "herdr-glass-toast",
  "theme": "herdr-glass",
  "colors": {
    "canvas": "#00000000",
    "chrome": "#00000000",
    "background": "#282c3400",
    "surface": "#24272ef7",
    "raised": "#ffffff1c",
    "hover": "#ffffff1a",
    "selected": "#ffffff24",
    "border": "#ffffff26",
    "accent": "#81a2be",
    "foreground": "#d2d4d8",
    "muted": "#ffffffb3",
    "dim": "#ffffff80",
    "done": "#8cc27d",
    "popover": "#1a1c22eb"
  },
  "font": "MesloLGM Nerd Font Mono",
  "font_size": 14,
  "font_weight": 400,
  "terminal_line_height": 1.12,
  "background": {
    "image": "mods/herdr-glass-bg/presets/graphite.jpg",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    16
  ],
  "terminal_opacity": 0,
  "padding": 10,
  "gap": 10,
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 250
      },
      "min": 44,
      "max": 480,
      "background": "#15171d66",
      "border": {
        "width": 1,
        "color": "#ffffff1f"
      },
      "radius": 16,
      "shadow": "lg",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "herdr-glass-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "herdr-glass-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "herdr-glass-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 97
          },
          "content": {
            "mod": "herdr-glass-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "gap": 10,
      "children": [
        {
          "id": "tabs",
          "type": "row",
          "size": {
            "px": 42
          },
          "background": "#15171d66",
          "border": {
            "width": 1,
            "color": "#ffffff1f"
          },
          "radius": 16,
          "shadow": "md",
          "resizable": false,
          "children": [
            {
              "id": "tab-strip",
              "type": "block",
              "window_drag": true,
              "content": {
                "mod": "herdr-glass-tabs"
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "gap": 10,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 16,
                  "background": "#21252bd9",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "#ffffff14"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#ffffff2e"
                  },
                  "header": {
                    "content": {
                      "mod": "herdr-glass-pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 340
              },
              "min": 280,
              "max": 900,
              "background": "#15171d66",
              "border": {
                "width": 1,
                "color": "#ffffff1f"
              },
              "radius": 16,
              "shadow": "lg",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 30
          },
          "background": "#15171d66",
          "border": {
            "width": 1,
            "color": "#ffffff1f"
          },
          "radius": 12,
          "content": {
            "mod": "herdr-glass-status"
          }
        }
      ]
    }
  ]
}

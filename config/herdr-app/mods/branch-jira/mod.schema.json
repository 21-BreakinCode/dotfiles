{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Branch Jira mod.json",
  "description": "What Herdr reads from Branch Jira's mod.json, and the settings it takes.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's schema, for editors."
    },
    "version": {
      "type": "string",
      "description": "The mod's version."
    },
    "title": {
      "type": "string",
      "description": "The mod's name, as Herdr shows it."
    },
    "place": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "none"
      ],
      "description": "Where Herdr first docks the mod. \"none\": only where a layout or another mod puts it."
    },
    "size": {
      "type": "number",
      "minimum": 0,
      "description": "Its first size, in pixels."
    },
    "focusable": {
      "type": "boolean",
      "description": "Lets pane.go give a shown copy the keyboard."
    },
    "overlay": {
      "type": "object",
      "description": "How mod.open shows it.",
      "properties": {
        "kind": {
          "enum": [
            "dialog",
            "popup",
            "window"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Your changes. A setting left out uses its default.",
      "additionalProperties": false,
      "properties": {
        "refresh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "every": {
              "title": "Refresh",
              "description": "How often a visible panel refreshes issues.",
              "type": [
                "string",
                "integer"
              ],
              "format": "duration",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
              "default": "60s"
            },
            "search_debounce": {
              "title": "Search delay",
              "description": "How long typing pauses before a search runs.",
              "type": [
                "string",
                "integer"
              ],
              "format": "duration",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
              "default": "450ms"
            }
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_identifiers": {
              "title": "Issues per branch",
              "description": "The most issue identifiers one branch name may carry.",
              "type": "integer",
              "minimum": 1,
              "default": 4
            }
          }
        },
        "worktrees": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "title": "Worktree folder",
              "description": "Fallback folder for Start work when Herdr settings.json has no worktrees.directory.",
              "type": "string",
              "default": "~/.herdr/worktrees"
            },
            "open_with": {
              "title": "Open with",
              "description": "What a new worktree opens: terminal, or an installed agent's key such as claude.",
              "type": "string",
              "default": "terminal"
            }
          }
        },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Board",
              "description": "The Jira board the panel shows: its columns, and your issues through its filter.",
              "type": "string",
              "default": "CR Kanban"
            }
          }
        }
      }
    }
  }
}
